{
  "name": "relic-revival-run",
  "version": "0.1.0",
  "private": true,
  "description": "Relic Revival Run — restore cultural heritage on the run.",
  "author": "Studio Jojo",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "package:itch": "npm run build && node scripts/zip-itch.mjs",
    "package:win": "npm run build && electron-builder --win portable nsis",
    "placeholders": "tsx tools/placeholders/generate.ts"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "perfect-freehand": "^1.2.3",
    "phaser": "^3.90.0",
    "svg-path-properties": "^2.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "fun.studiojojo.relicrevivalrun",
    "productName": "Relic Revival Run",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    }
  }
}
